+        }
+
+        var el = function (id) {
+          return document.getElementById(id);
+        };
+        var loginView = el("login");
+        var appView = el("app");
+        var grid = el("grid");
+        var status = el("status");
+        var drawer = el("drawer");
+        var treeBox = el("tree");
+        var viewer = el("viewer");
+        var big = el("big");
+
+        function showLogin(message) {
+          appView.hidden = true;
+          viewer.hidden = true;
+          drawer.hidden = true;
