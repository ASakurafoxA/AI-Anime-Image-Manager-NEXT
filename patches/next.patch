+          hasMore: true,
+          imageMode: false,
+          items: 0,
+          lastMonth: "",
+          limit: 60,
+          loading: false,
+          offset: 0,
+          order: "desc",
+          query: "",
+          sizeIndex: -1,
+          sort: "date",
+          tab: "folder",
+          tagId: null,
+          tree: { folder: [], tag: [] },
+          treeQuery: "",
+          treeLoaded: false,
