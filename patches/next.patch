+  function normalizeColor(input: string): string | null {
+    const value = input.trim();
+    const rgbMatch =
+      /^rgba?\(\s*(-?\d{1,3})\s*[,\s]\s*(-?\d{1,3})\s*[,\s]\s*(-?\d{1,3})/i.exec(
+        value
+      );
+    if (rgbMatch) {
