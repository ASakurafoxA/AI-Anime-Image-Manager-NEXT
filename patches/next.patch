+    setPermanentPassword("lanpass1");
+    expect(store.get(LAN_PERMANENT_HASH_KEY)).not.toBe(first);
+    expect(verifyLanPassword("lanpass1").ok).toBe(true);
+  });
+
+  it("拒绝过短的口令，边界长度可以通过", () => {
+    expect(() =>
+      setPermanentPassword("x".repeat(MIN_PASSWORD_LENGTH - 1))
