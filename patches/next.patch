+
+function formatRemaining(
+  ms: number,
+  hourLabel: string,
+  minuteLabel: string
+): string {
+  const totalMinutes = Math.max(0, Math.ceil(ms / 60_000));
+  const hours = Math.floor(totalMinutes / 60);
+  const minutes = totalMinutes % 60;
+  return hours > 0
+    ? `${hours} ${hourLabel} ${minutes} ${minuteLabel}`
+    : `${minutes} ${minuteLabel}`;
+}
+
+/** 随机口令的"只看一次"提示框。 */
