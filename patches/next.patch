+const pathState = vi.hoisted(() => ({ tempRoot: "" }));
+
+vi.mock("@/services/lan-access", () => ({
+  getCredentialRevision: () => lanStub.revision,
+  getLanConfig: () => ({
+    enabled: true,
+    hasPermanentPassword: true,
+    listeningOnLan: true,
+    port: lanStub.port,
+    tempPasswordActive: false,
+    tempPasswordExpiresAt: null,
