+  if (trimmed.length < MIN_PASSWORD_LENGTH) {
+    throw new Error(`口令至少需要 ${MIN_PASSWORD_LENGTH} 位`);
+  }
+  const { hash, salt } = hashPassword(trimmed);
+  setSetting(LAN_PERMANENT_HASH_KEY, hash);
+  setSetting(LAN_PERMANENT_SALT_KEY, salt);
