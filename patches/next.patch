+          return d.getFullYear() + "年" + (d.getMonth() + 1) + "月";
+        }
+
+        function appendItem(item) {
+          var label = monthLabel(item.fileDate);
+          if (label !== state.lastMonth) {
+            state.lastMonth = label;
+            var header = document.createElement("div");
+            header.className = "month";
+            header.textContent = label;
+            grid.appendChild(header);
+          }
+          var box = document.createElement("div");
+          box.className = "cell";
+          var img = document.createElement("img");
+          img.loading = "lazy";
+          img.decoding = "async";
+          img.alt = item.filename;
+          img.src = item.urls.thumb;
+          box.appendChild(img);
+          box.onclick = function () {
+            openViewer(item);
+          };
+          grid.appendChild(box);
+        }
+
+        function buildUrl() {
+          var parts = [
+            "limit=" + state.limit,
+            "offset=" + state.offset,
+            "sort=" + state.sort,
+            "order=" + state.order,
+          ];
+          if (state.query) {
+            parts.push("q=" + encodeURIComponent(state.query));
+          }
+          if (state.folderId !== null) {
+            parts.push("folderId=" + state.folderId);
+          }
+          if (state.tagId !== null) {
+            parts.push("tagId=" + state.tagId);
+          }
+          return "/api/photos?" + parts.join("&");
+        }
+
+        function load(reset) {
+          if (state.loading) {
+            return;
+          }
+          if (reset) {
+            state.offset = 0;
+            state.hasMore = true;
+            state.imageMode = false;
+            state.items = 0;
+            state.lastMonth = "";
+            grid.textContent = "";
+            // 换筛选/换排序/搜索时也回到顶部，避免停在半截
+            window.scrollTo(0, 0);
+          }
+          if (!state.hasMore) {
+            return;
+          }
+          state.loading = true;
+          setStatus("加载中…");
+          api(buildUrl())
+            .then(function (data) {
+              state.total = data.total;
+              state.hasMore = data.hasMore;
+              state.offset = data.offset + data.items.length;
+              data.items.forEach(function (item) {
+                state.items += 1;
+                appendItem(item);
+              });
+              if (state.items === 0) {
+                setStatus(
+                  state.query || state.folderId !== null || state.tagId !== null
+                    ? "这里没有照片。"
+                    : "图库里还没有照片。"
+                );
+              } else if (state.hasMore) {
+                setStatus(
+                  "已显示 " +
+                    state.items +
+                    " 张" +
+                    (data.mode === "semantic"
+                      ? "（搜索命中）"
+                      : " / " + state.total)
+                );
+              } else {
+                setStatus(
+                  (data.mode === "semantic" ? "搜索命中 " : "共 ") +
+                    state.total +
+                    " 张"
+                );
+              }
+            })
+            .catch(function (error) {
+              if (error && error.message !== "unauthorized") {
+                setStatus("加载失败：" + error.message, true);
+              } else {
+                setStatus("");
+              }
+            })
+            .then(function () {
+              state.loading = false;
+            });
+        }
+
+        /* ── 识图（以图搜图）────────────────────────────────
+           把选中的图 POST 给服务端，服务端算特征 + 向量检索后回一批照片。
+           服务端会限流、限 8MB、只收图片，且不把上传的图留在磁盘上。 */
+
+        function pickImage() {
+          el("pick").click();
+        }
+
+        function showImageResults(items, note) {
+          state.imageMode = true;
+          state.hasMore = false;
+          state.loading = false;
+          state.items = 0;
+          state.lastMonth = "";
+          grid.textContent = "";
+          items.forEach(function (item) {
+            state.items += 1;
+            appendItem(item);
+          });
+          syncChip();
+          window.scrollTo(0, 0);
+          if (items.length === 0) {
+            setStatus(note || "没有找到相似的图片。");
+          } else {
+            setStatus("识图命中 " + items.length + " 张" + (note ? "（" + note + "）" : ""));
+          }
+        }
+
+        function uploadForSearch(file) {
+          if (!file) {
+            return;
+          }
+          setStatus("识图中…（" + Math.round(file.size / 1024) + " KB）");
+          fetch("/api/search-by-image", {
+            body: file,
+            headers: { "content-type": file.type || "image/jpeg" },
+            method: "POST",
+          })
+            .then(function (res) {
+              if (res.status === 401) {
+                showLogin("口令已失效，请重新输入。");
+                throw new Error("unauthorized");
+              }
+              return res.json().then(function (data) {
+                return { data: data, status: res.status };
+              });
+            })
+            .then(function (result) {
+              if (result.status !== 200) {
+                throw new Error(errorText(result.status, result.data));
+              }
+              showImageResults(result.data.items || []);
+            })
+            .catch(function (error) {
+              if (error && error.message !== "unauthorized") {
+                setStatus("识图失败：" + error.message, false);
+              }
+            });
+        }
+
+        function errorText(status, data) {
+          if (status === 413) {
+            return "图片太大（上限 8 MB）";
+          }
+          if (status === 415) {
+            return "只支持图片文件";
+          }
+          if (status === 429) {
+            return "操作太频繁，请等一分钟再试";
+          }
+          if (status === 503) {
+            return "AI 还没就绪（正在加载模型），稍后再试";
+          }
+          return (data && data.error) || "HTTP " + status;
+        }
+
+        /* ── 大图 ─────────────────────────────────────────── */
+
+        function openViewer(item) {
+          viewer.hidden = false;
+          el("vSpin").hidden = false;
+          el("vSpin").textContent = "加载中…";
+          // 先给 800px 的 webp（快），要细节再点「原图」
+          big.src = item.urls.thumb.replace("size=md", "size=lg");
+          big.alt = item.filename;
+          el("vName").textContent =
+            item.filename +
+            " · " +
+            (item.width || "?") +
+            "×" +
+            (item.height || "?");
+          el("dlBtn").href = item.urls.download;
+          el("dlBtn").setAttribute("download", item.filename);
+          el("origBtn").onclick = function () {
+            el("vSpin").hidden = false;
+            el("vSpin").textContent = "加载原图…";
+            big.src = item.urls.image;
+          };
+        }
+
+        big.onload = function () {
+          el("vSpin").hidden = true;
+        };
+        big.onerror = function () {
+          el("vSpin").hidden = false;
+          el("vSpin").textContent = "图片加载失败";
+        };
+
+        /* ── 事件 ─────────────────────────────────────────── */
+
+        function doLogin() {
+          var pw = el("pw").value;
+          if (!pw) {
+            return;
+          }
+          el("loginMsg").textContent = "";
+          api("/api/login", {
+            method: "POST",
+            headers: { "content-type": "application/json" },
+            body: JSON.stringify({ password: pw }),
+          })
+            .then(function () {
+              el("pw").value = "";
+              showApp();
+              loadTree();
+              load(true);
+            })
+            .catch(function (error) {
+              el("loginMsg").textContent =
+                error && error.message === "unauthorized"
+                  ? "口令不对，或者临时口令已经过期。"
+                  : "登录失败：" + error.message;
+            });
+        }
+
+        function doLogout() {
+          fetch("/api/logout", { method: "POST" }).then(function () {
+            state.treeLoaded = false;
+            state.tree = { folder: [], tag: [] };
+            state.folderId = null;
+            state.tagId = null;
+            showLogin("已退出。");
+          });
+        }
+
+        el("loginBtn").onclick = doLogin;
+        el("pw").addEventListener("keydown", function (e) {
+          if (e.key === "Enter") {
+            doLogin();
+          }
+        });
+        el("out").onclick = doLogout;
+        el("menu").onclick = openDrawer;
+        el("pickBtn").onclick = pickImage;
+        el("pick").onchange = function (e) {
+          var file = e.target.files && e.target.files[0];
+          // 立刻清空 input，否则同一张图选第二次不会触发 change
+          e.target.value = "";
+          uploadForSearch(file);
+        };
+        el("size").onclick = function () {
+          applySize(state.sizeIndex + 1);
+        };
+        initSize();
+        el("scrim").onclick = closeDrawer;
+        el("navAll").onclick = function () {
+          state.folderId = null;
+          state.imageMode = false;
+          state.tagId = null;
+          state.query = "";
+          el("q").value = "";
+          syncChip();
+          renderTree();
+          closeDrawer();
+          load(true);
+        };
+        el("chip").onclick = function () {
+          state.folderId = null;
+          state.imageMode = false;
+          state.tagId = null;
+          syncChip();
+          renderTree();
+          load(true);
+        };
+        Array.prototype.forEach.call(
+          el("tabs").querySelectorAll("button"),
+          function (button) {
+            button.onclick = function () {
+              state.tab = button.dataset.tab;
+              state.treeQuery = "";
+              el("treeFilter").value = "";
+              el("treeFilter").placeholder =
+                state.tab === "folder" ? "搜索文件夹…" : "搜索标签…";
+              Array.prototype.forEach.call(
+                el("tabs").querySelectorAll("button"),
+                function (other) {
+                  other.className = other === button ? "on" : "";
+                }
+              );
+              renderTree();
+            };
+          }
+        );
+        el("treeFilter").addEventListener("input", function (e) {
+          state.treeQuery = e.target.value.trim();
+          renderTree();
+        });
+        el("closeBtn").onclick = function () {
+          viewer.hidden = true;
+          big.removeAttribute("src");
+        };
+        el("sort").onchange = function (e) {
+          var parts = String(e.target.value).split("|");
+          state.sort = parts[0];
+          state.order = parts[1];
+          load(true);
+        };
+
+        var timer = null;
+        el("q").addEventListener("input", function (e) {
+          var value = e.target.value;
+          if (timer) {
+            clearTimeout(timer);
+          }
+          timer = setTimeout(function () {
+            state.query = value.trim();
+            load(true);
+          }, 350);
+        });
+
+        window.addEventListener("scroll", function () {
+          if (
+            state.loading ||
+            !state.hasMore ||
+            viewer.hidden === false ||
+            drawer.hidden === false
+          ) {
+            return;
+          }
+          if (
+            window.innerHeight + window.scrollY >
+            document.body.offsetHeight - 700
+          ) {
+            load(false);
+          }
+        });
+
+        // 启动：先看有没有有效会话（有就直接进列表，没有就显示口令框）
+        fetch("/api/photos?limit=1")
+          .then(function (res) {
+            if (res.status === 401) {
+              showLogin("");
+              return;
+            }
+            showApp();
+            loadTree();
+            load(true);
+          })
+          .catch(function () {
+            showLogin("连不上服务，请确认手机和电脑在同一个网络。");
+          });
+      })();
+    </script>
+  </body>
+</html>

