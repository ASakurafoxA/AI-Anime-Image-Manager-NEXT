+import ort from "onnxruntime-node";
+
+const MODEL =
+  "./models/pixai-tagger-v1.0/pixai-tagger-v1.0.onnx";
+
+function show(label, meta) {
+  console.log(label);
+  for (const [name, info] of Object.entries(meta)) {
+    console.log(
+      `  ${name}: type=${info.type} dims=[${(info.shape ?? info.dims ?? []).join(", ")}]`
+    );
+  }
+}
+
