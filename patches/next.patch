+    setPermanentPassword("x".repeat(MIN_PASSWORD_LENGTH));
+    expect(verifyLanPassword("x".repeat(MIN_PASSWORD_LENGTH)).ok).toBe(true);
+  });
+
+  it("端口可以手改；非法值被拒绝，库里存坏了会自动换成随机端口", () => {
+    setLanPort(5000);
