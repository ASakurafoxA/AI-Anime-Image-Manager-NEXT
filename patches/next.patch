+      );
+    }
+    await pixaiTable.delete(
+      `photo_id IN (${chunk.map((entry) => entry.photoId).join(",")})`
+    );
+    await pixaiTable.add(
+      chunk.map((entry) => ({
+        photo_id: entry.photoId,
+        vector: entry.vector,
+      }))
+    );
+  }
+}
