+          button.textContent = CELL_STEPS[clamped].label;
+          button.className = clamped === defaultSizeIndex() ? "" : "on";
+          try {
+            localStorage.setItem(CELL_KEY, String(clamped));
+          } catch (e) {
+            /* 隐私模式下写不进去也没关系 */
+          }
+        }
+
+        function initSize() {
+          var stored = null;
+          try {
+            stored = localStorage.getItem(CELL_KEY);
+          } catch (e) {
